{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gethack.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://gethack.onrender.com/uploads/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://gethack.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://gethack.onrender.com/robots.txt"
    },
    {
      "source": "/((?!api|uploads|socket.io|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
